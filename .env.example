# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (also used as JWT fallback if JWT_SECRET is empty)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET=               # Recommended. If empty in production, falls back to APP_SECRET (never the old hardcoded key).
INIT_TABLES_SECRET=       # Required before any /api/init-* or migrate/reset route responds.

# ── Optional first-run admin seed (do not leave set forever) ────
EMPLOYEE_SEED_PASSWORD=   # Only to create a missing account on boot
EMPLOYEE_SEED_USERNAME=admin
EMPLOYEE_SEED_NAME=Admin
EMPLOYEE_SEED_STORE_ID=1

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Outlet pricing assistant ────────────────────────────────────
OPENAI_API_KEY=           # Required for photo → price suggestion (gpt-4o-mini vision)
OPENAI_VISION_MODEL=gpt-4o-mini
USD_TO_CRC=520            # CRC per 1 USD for suggestions
OUTLET_OF_US_FACTOR=0.55  # Suggested CR sell ≈ US$ × FX × this factor (confirm in UI)

NODE_ENV=development
